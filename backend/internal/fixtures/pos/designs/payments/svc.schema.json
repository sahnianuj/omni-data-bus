{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentDocument (SVC)",
  "description": "A stored-value (gift) card.",
  "type": "object",
  "required": [
    "paymentType",
    "id",
    "amountChargedInCents",
    "tipInCents",
    "status"
  ],
  "properties": {
    "paymentType": {
      "type": "string",
      "const": "SVC"
    },
    "id": {
      "type": "string",
      "examples": [
        "9c1d2e3f-0000-4000-8000-000000000003"
      ]
    },
    "encryptedNumber": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "enc-svc-1"
      ]
    },
    "encryptionKeyID": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "2b3c4d5e-0000-4000-8000-000000000005"
      ]
    },
    "cardHash": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "sha256-svc-1"
      ]
    },
    "last4Digits": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "1001"
      ]
    },
    "cardImage": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "https://img.example/cards/svc-1.png"
      ]
    },
    "isDefault": {
      "type": "boolean",
      "examples": [
        false
      ]
    },
    "accountID": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "7a8b9c0d-0000-4000-8000-000000000006"
      ]
    },
    "balanceInCents": {
      "type": [
        "integer",
        "null"
      ],
      "examples": [
        2501
      ]
    },
    "authorizationCode": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "AUTH1"
      ]
    },
    "entryMethod": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "swipe"
      ]
    },
    "amountChargedInCents": {
      "type": "integer",
      "examples": [
        795
      ]
    },
    "tipInCents": {
      "type": "integer",
      "examples": [
        0
      ]
    },
    "transactionID": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "5e6f7a8b-0000-4000-8000-000000000004"
      ]
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "voided": {
      "type": "boolean",
      "description": "Not populated.",
      "examples": [
        false
      ]
    },
    "voidedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "examples": [
        "2026-07-19T10:29:58Z"
      ]
    }
  }
}
