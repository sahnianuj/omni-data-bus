{
  "driving": "pos.carts",
  "key": "cart::{id}",
  "bindings": {
    "customer": {
      "table": "pos.customers",
      "kind": "one-to-many",
      "adapter": "first"
    },
    "partner": {
      "table": "pos.partners",
      "kind": "many-to-one"
    },
    "items[]": {
      "table": "pos.cart_items",
      "kind": "one-to-many"
    },
    "items[].modifiers[]": {
      "table": "pos.customizations",
      "kind": "one-to-many"
    },
    "items[].appliedRewards[]": {
      "table": "pos.applied_rewards",
      "kind": "many-to-one",
      "adapter": "wrap"
    },
    "pricing": {
      "fromParent": true
    },
    "pricing.modifiers[]": {
      "notPopulated": true
    },
    "pricing.taxLabels[]": {
      "notPopulated": true
    },
    "payments[]": {
      "table": "pos.collected_payments",
      "kind": "one-to-many",
      "variants": "paymentType"
    },
    "associatedScan": {
      "notPopulated": true
    },
    "receipt": {
      "notPopulated": true
    }
  },
  "fields": {
    "type": {
      "constant": "cart"
    },
    "id": {
      "expression": "concat('cart::', row.id)"
    },
    "version": {
      "constant": 1
    },
    "status": {
      "expression": "saved_orders.cart_id != nil ? 'saved' : row.status"
    },
    "channel": {
      "source": "carts.channel"
    },
    "skipFulfillment": {
      "source": "carts.skip_fulfillment"
    },
    "submitAfterTipAbort": {
      "source": "carts.submit_after_tip_abort"
    },
    "consumptionType": {
      "source": "carts.consumption_type"
    },
    "storeNumber": {
      "source": "carts.store_number"
    },
    "partnerNumber": {
      "source": "carts.partner_number"
    },
    "registerNumber": {
      "source": "carts.register_number"
    },
    "orderNotes": {
      "source": "carts.order_notes"
    },
    "customerNamePrompt": {
      "notPopulated": true
    },
    "taxDataID": {
      "expression": "concat('tax_data::', row.id)"
    },
    "selectedPaymentID": {
      "notPopulated": true
    },
    "loyaltyTransactionID": {
      "source": "carts.loyalty_transaction_id"
    },
    "savedAt": {
      "source": "saved_orders.saved_at"
    },
    "orderCollectionType": {
      "source": "saved_orders.order_collection_type"
    },
    "createdAt": {
      "source": "carts.created_at"
    },
    "updatedAt": {
      "unresolved": true
    },
    "closedAt": {
      "source": "carts.closed_at"
    },
    "voidedAt": {
      "source": "carts.voided_at"
    },
    "customer.userID": {
      "notPopulated": true
    },
    "customer.firstName": {
      "source": "customers.first_name"
    },
    "customer.lastName": {
      "source": "customers.last_name"
    },
    "customer.starsEarned": {
      "source": "customers.stars_earned"
    },
    "customer.loyaltyID": {
      "source": "customers.loyalty_id"
    },
    "customer.alias": {
      "source": "customers.alias"
    },
    "customer.validPartner": {
      "source": "customers.valid_partner"
    },
    "customer.partnerNumber": {
      "source": "customers.partner_number"
    },
    "customer.partnerName": {
      "source": "customers.partner_name"
    },
    "customer.partnerStatus": {
      "source": "customers.partner_status"
    },
    "customer.eligibleBenefits": {
      "source": "customers.eligible_benefits"
    },
    "customer.tierNumber": {
      "source": "customers.tier_number"
    },
    "partner.number": {
      "source": "partners.number"
    },
    "partner.name": {
      "expression": "concat(partners.first_name, ' ', partners.last_name)"
    },
    "items[].id": {
      "source": "cart_items.id"
    },
    "items[].name": {
      "source": "cart_items.name"
    },
    "items[].quantity": {
      "constant": 1
    },
    "items[].sellableItemId": {
      "source": "cart_items.sellable_item_id"
    },
    "items[].menuProductId": {
      "source": "cart_items.menu_product_id"
    },
    "items[].formCode": {
      "source": "cart_items.form_code"
    },
    "items[].sizeCode": {
      "source": "cart_items.size_code"
    },
    "items[].productTypeId": {
      "source": "cart_items.product_type_id"
    },
    "items[].servingSizeName": {
      "source": "cart_items.serving_size_name"
    },
    "items[].sequenceNumber": {
      "source": "cart_items.sequence_number"
    },
    "items[].displayIndex": {
      "source": "cart_items.display_index"
    },
    "items[].basePrice": {
      "source": "cart_items.base_price",
      "transform": "cents"
    },
    "items[].price": {
      "source": "cart_items.price",
      "transform": "cents"
    },
    "items[].priceOverride": {
      "source": "cart_items.price_override",
      "transform": "cents"
    },
    "items[].priceOverrideAuthorized": {
      "source": "cart_items.price_override_authorized"
    },
    "items[].priceOverrideAuthorizedBy": {
      "notPopulated": true
    },
    "items[].priceOverrideReason": {
      "notPopulated": true
    },
    "items[].redemptionTier": {
      "source": "cart_items.redemption_tier"
    },
    "items[].isRefund": {
      "source": "cart_items.is_refund"
    },
    "items[].isAvailable": {
      "source": "cart_items.is_available"
    },
    "items[].isImpulseItem": {
      "source": "cart_items.is_impulse_item"
    },
    "items[].isRefill": {
      "source": "cart_items.is_refill"
    },
    "items[].itemAvailabilityOverride": {
      "source": "cart_items.item_availability_override"
    },
    "items[].askMeInstructions": {
      "source": "cart_items.ask_me_instructions"
    },
    "items[].imageUrl": {
      "source": "cart_items.image_url"
    },
    "items[].voided": {
      "source": "cart_items.voided"
    },
    "items[].modifiers[].id": {
      "source": "customizations.id"
    },
    "items[].modifiers[].label": {
      "source": "customizations.name"
    },
    "items[].modifiers[].value": {
      "source": "customizations.name"
    },
    "items[].modifiers[].valueString": {
      "source": "customizations.name"
    },
    "items[].modifiers[].menuProductId": {
      "source": "customizations.menu_product_id"
    },
    "items[].modifiers[].sellableItemId": {
      "source": "customizations.sellable_item_id"
    },
    "items[].modifiers[].formCode": {
      "source": "customizations.form_code"
    },
    "items[].modifiers[].sizeCode": {
      "source": "customizations.size_code"
    },
    "items[].modifiers[].quantity": {
      "source": "customizations.quantity"
    },
    "items[].modifiers[].price": {
      "source": "customizations.price",
      "transform": "cents"
    },
    "items[].modifiers[].isAvailable": {
      "source": "customizations.is_available"
    },
    "items[].modifiers[].itemAvailabilityOverride": {
      "source": "customizations.item_availability_override"
    },
    "items[].modifiers[].voided": {
      "source": "customizations.voided"
    },
    "items[].appliedRewards[].id": {
      "source": "applied_rewards.id"
    },
    "items[].appliedRewards[].rewardCode": {
      "source": "applied_rewards.reward_code"
    },
    "items[].appliedRewards[].rewardType": {
      "notPopulated": true
    },
    "items[].appliedRewards[].description": {
      "source": "applied_rewards.description"
    },
    "items[].appliedRewards[].accessibilityLabel": {
      "notPopulated": true
    },
    "items[].appliedRewards[].value": {
      "notPopulated": true
    },
    "pricing.totalInCents": {
      "source": "carts.total_in_cents"
    },
    "pricing.subTotalInCents": {
      "source": "carts.subtotal_in_cents"
    },
    "pricing.taxInCents": {
      "source": "carts.tax_in_cents"
    },
    "pricing.discountInCents": {
      "source": "carts.discount_in_cents"
    },
    "pricing.tipInCents": {
      "aggregate": "sum(collected_payments.tip_in_cents)"
    },
    "pricing.totalToDisplay": {
      "source": "carts.total_to_display",
      "transform": "toString"
    },
    "pricing.label": {
      "notPopulated": true
    }
  }
}
