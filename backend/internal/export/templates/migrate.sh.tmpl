#!/usr/bin/env bash
# shellcheck disable=SC2329 # on_signal runs from trap
# Omni-Data-Bus migration runner, odb {{.Version}}.
#
# The same script for every migration: it reads two files from its own folder and runs odb.
#   config.json    where: the source and target connection details (edit it per environment)
#   mappings.json  what: the tables, the documents they become, and how (exported from the tool)
# Give it another pair of files for another migration. Run ./migrate.sh help for the commands.
# Needs bash 3.2 or later, and to fetch odb: curl or wget, plus sha256sum or shasum (or docker).
set -euo pipefail

ODB_VERSION={{sh .Version}}
ODB_IMAGE={{sh .Image}}
ODB_DOWNLOAD_URL={{sh .DownloadURL}}
ODB_SHA256_linux_amd64={{sh (index .Checksums "linux_amd64")}}
ODB_SHA256_linux_arm64={{sh (index .Checksums "linux_arm64")}}
ODB_SHA256_darwin_amd64={{sh (index .Checksums "darwin_amd64")}}
ODB_SHA256_darwin_arm64={{sh (index .Checksums "darwin_arm64")}}
ODB_COSIGN_IDENTITY={{sh .CosignIdentity}}

# Everything is read from and written to the script's own folder, wherever it is run from.
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

: "${ODB_CONFIG:=$HERE/config.json}"       # where: connection details
: "${ODB_MAPPINGS:=$HERE/mappings.json}"   # what: the mappings
: "${ODB_STATE_DIR:=$HERE/odb-state}"      # checkpoint, errors.jsonl, report.json
: "${ODB_TARGET_PATH:=}"                   # a directory target's folder, instead of config.json's
: "${ODB_RUNTIME:=auto}"                   # auto | binary | docker
: "${ODB_DOCKER_ARGS:=}"                   # extra docker run arguments, e.g. --network host
: "${ODB_CACHE_DIR:=$HERE/odb-cache}"      # downloaded odb binaries

ODB=""
MODE=""
RUNNING=""
WORK=""

cleanup() {
  if [ -n "$WORK" ] && [ -d "$WORK" ]; then
    rm -rf "$WORK"
  fi
}
# While odb runs, it handles Ctrl+C itself (it drains, checkpoints and exits 5); the script
# then passes its exit code through. Otherwise a signal stops the script at once.
on_signal() {
  if [ -n "$RUNNING" ]; then
    return
  fi
  cleanup
  exit "$1"
}
trap cleanup EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

note() { printf 'migrate.sh: %s\n' "$*" >&2; }
die() {
  local code=$1
  shift
  note "$*"
  exit "$code"
}

usage() {
  cat <<'EOF'
usage: ./migrate.sh <command> [options] [-- odb run options]

commands:
  preflight          check the source, credentials, schema drift and target; writes nothing
  run [--mapping M]  migrate (the run checks everything first); exit code as odb run
  resume             continue an interrupted run from ODB_STATE_DIR
  status             summarize the run in ODB_STATE_DIR
  verify             count each mapping's documents in the target
  inspect            what mappings.json migrates, field by field (no secrets)
  help               this text

files (beside the script):
  config.json    where: source and target connection details   (ODB_CONFIG to use another)
  mappings.json  what: the mappings                            (ODB_MAPPINGS to use another)

Optional ODB_* settings: README.md.

exit codes: 0 completed, 2 completed with errors, 3 failed, 4 preflight or configuration
            error, 5 cancelled (run ./migrate.sh resume)
EOF
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

platform() {
  local os arch
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) die 4 "unsupported operating system $(uname -s): use ODB_RUNTIME=docker" ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64)
      # An Intel shell under Rosetta reports x86_64 on Apple silicon: ask for the real CPU.
      if [ "$os" = darwin ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then
        arch=arm64
      else
        arch=amd64
      fi
      ;;
    arm64 | aarch64) arch=arm64 ;;
    *) die 4 "unsupported CPU $(uname -m): use ODB_RUNTIME=docker" ;;
  esac
  printf '%s_%s' "$os" "$arch"
}

version_of() {
  "$1" version --json 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p'
}

# use_bin uses an odb binary if it runs here and is this script's version.
use_bin() {
  local v
  [ -x "$1" ] || return 1
  v=$(version_of "$1" || true)
  if [ "$v" != "$ODB_VERSION" ]; then
    note "skipping $1: it is odb ${v:-unknown or not for this machine}, this script needs $ODB_VERSION"
    return 1
  fi
  ODB=$1
  MODE=binary
}

use_path() {
  local p
  p=$(command -v odb 2>/dev/null || true)
  [ -n "$p" ] || return 1
  use_bin "$p"
}

use_docker() {
  command -v docker >/dev/null 2>&1 || return 1
  MODE=docker
}

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    note "neither curl nor wget is installed"
    return 1
  fi
}

# download fetches odb for this machine into the cache, checked against the checksum written in
# this script (and the release signature, when cosign is installed).
download() {
  local plat want dir name tgz got
  plat=$(platform)
  case "$plat" in
    linux_amd64) want=$ODB_SHA256_linux_amd64 ;;
    linux_arm64) want=$ODB_SHA256_linux_arm64 ;;
    darwin_amd64) want=$ODB_SHA256_darwin_amd64 ;;
    *) want=$ODB_SHA256_darwin_arm64 ;;
  esac
  [ -n "$want" ] || die 4 "no odb download for $plat. Put odb $ODB_VERSION beside this script (export it with odb included), set ODB_BIN=/path/to/odb, or install Docker"
  dir="$ODB_CACHE_DIR/$ODB_VERSION"
  name="odb_${ODB_VERSION}_${plat}.tar.gz"
  tgz="$dir/$name"
  mkdir -p "$dir"
  if [ ! -f "$tgz" ] || [ "$(sha256_of "$tgz")" != "$want" ]; then
    note "downloading $ODB_DOWNLOAD_URL/$name"
    fetch "$ODB_DOWNLOAD_URL/$name" "$tgz.part" || die 4 "download failed: $ODB_DOWNLOAD_URL/$name"
    got=$(sha256_of "$tgz.part")
    if [ "$got" != "$want" ]; then
      rm -f "$tgz.part"
      die 4 "checksum mismatch for $name (got $got, expected $want); the download was deleted"
    fi
    if command -v cosign >/dev/null 2>&1; then
      WORK=$(mktemp -d "${TMPDIR:-/tmp}/odb-migrate.XXXXXX")
      if fetch "$ODB_DOWNLOAD_URL/SHA256SUMS" "$WORK/SHA256SUMS" && fetch "$ODB_DOWNLOAD_URL/SHA256SUMS.sigstore.json" "$WORK/SHA256SUMS.sigstore.json"; then
        cosign verify-blob --bundle "$WORK/SHA256SUMS.sigstore.json" --certificate-identity-regexp "$ODB_COSIGN_IDENTITY" \
          --certificate-oidc-issuer https://token.actions.githubusercontent.com "$WORK/SHA256SUMS" >/dev/null 2>&1 ||
          { rm -f "$tgz.part"; die 4 "the release signature doesn't verify"; }
        grep -q "^$want  $name\$" "$WORK/SHA256SUMS" || { rm -f "$tgz.part"; die 4 "$name isn't in the signed SHA256SUMS"; }
      fi
    fi
    mv "$tgz.part" "$tgz"
  fi
  rm -f "$dir/odb"
  tar -xzf "$tgz" -C "$dir" odb
  ODB="$dir/odb"
  MODE=binary
}

# resolve finds odb: ODB_BIN, the odb beside the script, odb on the PATH, Docker (auto only),
# then a download. Only odb of this script's version is used.
resolve() {
  case "$ODB_RUNTIME" in
    auto | binary | docker) ;;
    *) die 4 "ODB_RUNTIME must be auto, binary or docker" ;;
  esac
  if [ "$ODB_RUNTIME" = docker ]; then
    use_docker || die 4 "docker isn't installed"
    return
  fi
  if [ -n "${ODB_BIN:-}" ]; then
    use_bin "$ODB_BIN" || die 4 "ODB_BIN=$ODB_BIN isn't odb $ODB_VERSION"
    return
  fi
  if [ -e "$HERE/odb" ] && use_bin "$HERE/odb"; then
    return
  fi
  if use_path; then
    return
  fi
  if [ "$ODB_RUNTIME" = auto ] && use_docker; then
    return
  fi
  download
}

need() {
  [ -f "$1" ] || die 4 "$1 not found: it holds $2 (unzip the export again, or set $3)"
}

# absfile prints a file's absolute path (the docker runtime mounts its folder).
absfile() {
  printf '%s/%s' "$(cd "$(dirname "$1")" && pwd)" "${1##*/}"
}

abspath() {
  mkdir -p "$1"
  (cd "$1" && pwd)
}

# odb_exec runs odb with the two files and the state directory. SUB is "run", "run preflight"
# or "run verify". Docker mounts this folder at the same path, so every path means the same
# inside the container (and the state and a directory target too, when they're elsewhere).
odb_exec() {
  local sub=$1
  shift
  need "$ODB_CONFIG" "the source and target connection details" ODB_CONFIG
  need "$ODB_MAPPINGS" "the mappings to run" ODB_MAPPINGS
  local config mappings state target=""
  config=$(absfile "$ODB_CONFIG")
  mappings=$(absfile "$ODB_MAPPINGS")
  state=$(abspath "$ODB_STATE_DIR")
  set -- "$@" --mappings "$mappings" --config "$config" --state-dir "$state"
  if [ -n "$ODB_TARGET_PATH" ]; then
    target=$(abspath "$ODB_TARGET_PATH")
    set -- "$@" --target-path "$target"
  fi
  if [ "$MODE" != docker ]; then
    # shellcheck disable=SC2086 # sub is one or two words
    "$ODB" $sub "$@"
    return
  fi
  if [ -z "$target" ]; then
    # shellcheck disable=SC2086 # ODB_DOCKER_ARGS is a word list
    target=$(docker run --rm --user "$(id -u):$(id -g)" -v "${config%/*}:${config%/*}" \
      $ODB_DOCKER_ARGS "$ODB_IMAGE" run target-path --config "$config") || exit $?
    if [ -n "$target" ]; then
      mkdir -p "$target"
    fi
  fi
  local d=(run --rm -i --user "$(id -u):$(id -g)" -w "$HERE" -v "$HERE:$HERE")
  local p
  for p in "${config%/*}" "${mappings%/*}" "$state" ${target:+"$target"}; do
    case "$p/" in
      "$HERE"/*) ;;
      *) d+=(-v "$p:$p") ;;
    esac
  done
  if [ -t 0 ]; then
    d+=(-t)
  fi
  # shellcheck disable=SC2086 # ODB_DOCKER_ARGS is a word list, sub is one or two words
  docker "${d[@]}" $ODB_DOCKER_ARGS "$ODB_IMAGE" $sub "$@"
}

summary() {
  case "$1" in
    0) note "completed" ;;
    2) note "completed with errors: see $ODB_STATE_DIR/errors.jsonl and report.json" ;;
    3) note "failed: see $ODB_STATE_DIR/report.json; fix the cause, then ./migrate.sh resume" ;;
    4) note "not started: a preflight or configuration problem (above)" ;;
    5) note "cancelled after saving the checkpoint: ./migrate.sh resume continues" ;;
    *) note "odb exited with $1" ;;
  esac
}

run_cmd() {
  local sub=$1
  shift
  local args=() a
  for a in "$@"; do
    if [ "$a" != "--" ]; then
      args+=("$a")
    fi
  done
  resolve
  set +e
  RUNNING=1
  odb_exec "$sub" ${args[@]+"${args[@]}"}
  local code=$?
  RUNNING=""
  set -e
  summary "$code"
  return "$code"
}

main() {
  local cmd=${1:-help}
  if [ $# -gt 0 ]; then
    shift
  fi
  case "$cmd" in
    preflight) run_cmd "run preflight" "$@" ;;
    run) run_cmd run "$@" ;;
    resume) run_cmd run --resume "$@" ;;
    verify) run_cmd "run verify" "$@" ;;
    status)
      resolve
      local state
      state=$(abspath "$ODB_STATE_DIR")
      if [ "$MODE" = docker ]; then
        # shellcheck disable=SC2086 # ODB_DOCKER_ARGS is a word list
        docker run --rm -v "$state:$state" $ODB_DOCKER_ARGS "$ODB_IMAGE" run status --state-dir "$state"
      else
        "$ODB" run status --state-dir "$state"
      fi
      ;;
    inspect)
      need "$ODB_MAPPINGS" "the mappings to run" ODB_MAPPINGS
      resolve
      if [ "$MODE" = docker ]; then
        local mappings
        mappings=$(absfile "$ODB_MAPPINGS")
        # shellcheck disable=SC2086 # ODB_DOCKER_ARGS is a word list
        docker run --rm -v "${mappings%/*}:${mappings%/*}:ro" $ODB_DOCKER_ARGS "$ODB_IMAGE" bundle inspect "$mappings"
      else
        "$ODB" bundle inspect "$ODB_MAPPINGS"
      fi
      ;;
    help | -h | --help) usage ;;
    *)
      usage >&2
      exit 4
      ;;
  esac
}

main "$@"
