#!/usr/bin/env bash
# Runs CI's checks before every push (scripts/ci-local.sh, ~6 min), so a push doesn't find them failing.
# Needs Docker running: integration, the image and the e2e tests run in it.
# Skip once with: git push --no-verify     Installed by `make hooks` (or `make setup`).
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! docker info >/dev/null 2>&1; then
  echo "pre-push: Docker isn't running, so the integration, image and e2e checks can't run."
  echo "pre-push: start Docker and push again, or push without the checks with --no-verify."
  exit 1
fi
echo "pre-push: running CI's checks (~6 min; skip with git push --no-verify)"
if ! scripts/ci-local.sh; then
  echo
  echo "pre-push: push stopped, a CI check would fail. Fix it, or push anyway with --no-verify."
  exit 1
fi
