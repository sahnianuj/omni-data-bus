# ──────────────────────────────────────────────────────────────────────────────
# Omni-Data-Bus configuration
#
#   cp .env.example .env      # then fill in the values below
#
# .env is git-ignored. The server reads it automatically (from the repo root or the
# backend/ directory; override the path with OC_ENV_FILE). Real environment variables
# always win over values in the file.
#
# Values are taken literally (surrounding quotes are optional and removed); characters like $ ` # inside a
# value are kept as-is (a # only starts a comment at the start of a line).
# ──────────────────────────────────────────────────────────────────────────────

# ─── Mode ─────────────────────────────────────────────────────────────────────
# true = local development: plain-http cookies and fallbacks for anything left empty
# below. Keep true while running on your laptop; never set it in production.
OC_DEV=true

# ─── Metadata store: Couchbase Capella (REQUIRED) ────────────────────────────
# Where Omni-Data-Bus keeps its own data (users, projects, encrypted credentials, jobs).
#
# Before starting, in the Capella UI:
#   1. Create the bucket named in OC_META_BUCKET (default: omniconnect).
#      The SDK can't create buckets on Capella.
#   2. Create a database access credential with Read/Write access to that bucket.
#   3. Add this machine's public IP under Settings → Networking → Allowed IP addresses.
# On first start Omni-Data-Bus creates scope OC_META_SCOPE, its collections and indexes.
# If the credential can't, run `odb admin provision --print` (from backend/:
# `go run ./cmd/odb admin provision --print`) for the list to create by hand.

# Capella → your cluster → Connect → "Connection String" (starts with couchbases://)
OC_META_CONNSTR=couchbases://cb.xxxxxxxxxxxxxxxx.cloud.couchbase.com
OC_META_USERNAME=
OC_META_PASSWORD=
OC_META_BUCKET=omniconnect
OC_META_SCOPE=meta
# true for Capella (applies the WAN connection profile: longer timeouts).
OC_META_CAPELLA=true
# Create/upgrade collections and indexes on startup.
OC_META_AUTO_PROVISION=true
# Dev-only escape hatch for self-signed TLS on self-managed clusters. Keep false for Capella.
OC_META_TLS_SKIP_VERIFY=false

# ─── Credential encryption (REQUIRED) ────────────────────────────────────────
# Master key that encrypts every stored database password/certificate.
# Generate one:   openssl rand -base64 32
#            or:  cd backend && go run ./cmd/odb admin gen-key
# Keep it secret and backed up: losing it makes stored credentials unrecoverable.
# (With a remote metadata store the server refuses to start without it, even in dev mode.)
OC_MASTER_KEY=

# Key rotation (optional; replaces OC_MASTER_KEY when set):
#   OC_MASTER_KEYS=k2:<new base64 key>,k1:<old base64 key>
#   OC_MASTER_KEY_ACTIVE=k2
# then run: go run ./cmd/odb admin rotate-secrets
OC_MASTER_KEYS=
OC_MASTER_KEY_ACTIVE=

# ─── HTTP server ──────────────────────────────────────────────────────────────
OC_HTTP_ADDR=:8080
# Public origin of the web app (used for the CSRF origin check). Vite dev server by default.
OC_PUBLIC_URL=http://localhost:5173
# all | api | worker
OC_ROLE=all
OC_SHUTDOWN_TIMEOUT=30s

# ─── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
OC_LOG_LEVEL=info
# json | text  (text is easier to read locally)
OC_LOG_FORMAT=text

# ─── Metrics & tracing ────────────────────────────────────────────────────────
# Prometheus /metrics is on the public port unless this gives it its own listener, e.g. :9090
OC_METRICS_ADDR=
# Go profiling (net/http/pprof) on its own listener, for benchmark runs only (OC-034). Keep it on localhost.
# OC_PPROF_ADDR=127.0.0.1:6060
# OpenTelemetry traces over OTLP/HTTP, e.g. http://localhost:4318 (empty = tracing off)
OC_OTEL_EXPORTER_OTLP_ENDPOINT=
OC_OTEL_SAMPLE_RATIO=0.1

# ─── Egress control & audit ───────────────────────────────────────────────────
# Which database addresses users may connect to. Cloud metadata/link-local is always refused.
# true (self-hosted default) also allows private networks (10/8, 192.168/16, localhost…).
OC_ALLOW_PRIVATE_NETWORKS=true
# Extra allowed / refused ranges, comma-separated CIDRs (deny wins).
OC_EGRESS_ALLOW_CIDRS=
OC_EGRESS_DENY_CIDRS=
# Allowed destination ports (default: 5432-5439,6432,8091-8097,11207,11210,18091-18097,443).
OC_EGRESS_PORTS=
OC_AUDIT_RETENTION_DAYS=365

# ─── Accounts & sessions ─────────────────────────────────────────────────────
OC_SIGNUP_ENABLED=true
OC_SESSION_IDLE_TTL=12h
OC_SESSION_ABSOLUTE_TTL=168h
# Forced to false when OC_DEV=true (local http). Must be true behind https.
OC_SESSION_COOKIE_SECURE=true

# ─── Exported migrations (OC-050 – OC-055) ───────────────────────────────────
# Exports carry the project's saved credentials, always sealed with the user's passphrase.
# What migrate.sh's docker runtime runs (pin by digest in production) and where its binary
# runtime downloads odb from. Defaults: ghcr.io/sahnianuj/omni-data-bus:<version> and this
# version's GitHub release.
# OC_EXPORT_IMAGE=ghcr.io/sahnianuj/omni-data-bus@sha256:…
# OC_EXPORT_DOWNLOAD_URL=https://github.com/sahnianuj/omni-data-bus/releases/download/v2.0.0
# This version's odb tarballs + SHA256SUMS (`make dist`): their checksums go into every script,
# and odb can be embedded for any platform. Without it, only this server's platform embeds.
# OC_EXPORT_DIST_DIR=/opt/odb/dist
# OC_EXPORT_COSIGN_IDENTITY=^https://github.com/sahnianuj/omni-data-bus/

# ─── Integration tests (optional) ────────────────────────────────────────────
# By default `make test-integration` starts a Couchbase 8.0.3 container. To run the
# tests against another cluster instead (they use a throwaway it_<random> scope):
# OC_IT_META_CONNSTR=couchbase://localhost
# OC_IT_META_USERNAME=Administrator
# OC_IT_META_PASSWORD=password
