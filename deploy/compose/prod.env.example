# Omni-Data-Bus production settings for deploy/compose/prod.yml.
#   cp prod.env.example .env.prod      (.env.prod is git-ignored)
# Secrets are NOT set here: put the master key and the Capella password in ./secrets/ (see README.md).

# Image to run (pin a version in production).
ODB_IMAGE=ghcr.io/sahnianuj/omni-data-bus:1.0.0

# Public https origin users open (CSRF origin check). With the tls profile: https://$ODB_DOMAIN
OC_PUBLIC_URL=https://odb.example.com
# Domain Caddy requests a certificate for (tls profile only).
ODB_DOMAIN=odb.example.com
# Without the tls profile, publish the app port on all interfaces behind your own proxy:
# ODB_HTTP_BIND=0.0.0.0

# ─── Metadata store: Couchbase Capella ────────────────────────────────────────
OC_META_CONNSTR=couchbases://cb.xxxxxxxx.cloud.couchbase.com
OC_META_USERNAME=omnidb
OC_META_BUCKET=omniconnect
OC_META_SCOPE=meta
OC_META_CAPELLA=true
OC_META_AUTO_PROVISION=true

# ─── Behaviour ────────────────────────────────────────────────────────────────
OC_LOG_LEVEL=info
OC_SIGNUP_ENABLED=false
OC_SESSION_COOKIE_SECURE=true
OC_WORKER_MAX_JOBS=2
# Egress: allow private networks only if your databases live on them (self-hosted default true).
OC_ALLOW_PRIVATE_NETWORKS=true
# OC_EGRESS_DENY_CIDRS=10.0.0.0/8
OC_AUDIT_RETENTION_DAYS=365
# Tracing (optional): OTLP/HTTP collector
# OC_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
