# HTTPS reverse proxy for Omni-Data-Bus (compose profile "tls"). Caddy obtains and renews
# the certificate for ODB_DOMAIN automatically.
{
	admin 127.0.0.1:2019
}

{$ODB_DOMAIN} {
	encode zstd gzip
	# Server-Sent Events (live job progress) must not be buffered.
	reverse_proxy omni-data-bus:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
		}
	}
	# Metrics stay internal (they're on :9090, not proxied).
}
