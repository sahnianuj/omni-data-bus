      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(oc_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(oc_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx"
        }
