# ─── Secrets & local configuration (never commit) ─────────────────────────────
.env
.env.*
!.env.example
*.local
# Certificates and private keys (e.g. a downloaded Capella CA). Test fixtures are allowed.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
!**/testdata/**
secrets/
**/secrets/

# ─── Go ───────────────────────────────────────────────────────────────────────
/backend/bin/
# `go build ./cmd/odb` run in backend/ (make build writes bin/odb)
/backend/odb
/backend/coverage/
/backend/internal/httpapi/webdist/
*.test
*.out
*.coverprofile
*.prof
*.pprof
/backend/tmp/
__debug_bin*

# ─── Node / web ───────────────────────────────────────────────────────────────
node_modules/
/web/dist/
/web/coverage/
/web/playwright-report/
/web/test-results/
/web/blob-report/
/web/storybook-static/
/web/.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Benchmarks & infrastructure state ───────────────────────────────────────
/bench/results/*.pprof
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Terraform inputs (key names, CIDRs, account details); commit an *.example instead.
*.tfvars
!*.tfvars.example

# ─── Logs, caches, temp ───────────────────────────────────────────────────────
*.log
logs/
tmp/
.cache/

# ─── Editors & OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Compose smoke-test secrets (generated)
/deploy/compose/secrets-ci/

# Benchmark runs outside the release results (nightly history, local tries). Local runs'
# findings are summarised in bench/results/<release>/local/README.md; the raw runs stay local.
/bench/history/
/bench/results/*/local/*
!/bench/results/*/local/README.md

# ─── All-in-one image packages (make appliance-save) ───────────────────────────
/dist/
# The same archives (≈500 MB each) and their checksums wherever they're copied, and run.sh
# backups (all data, including generated passwords), e.g. from deploy/appliance/run.sh backup.
omni-data-bus-appliance-*.tar.gz
omni-data-bus-appliance-*.tar.gz.sha256
odb-backup-*.tar.gz

# Claude Code personal overrides (project hooks live in .claude/settings.json)
.claude/settings.local.json
